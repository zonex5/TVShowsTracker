<Window x:Class="TVShowsTracker.NoticeWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource AppWindow}" Icon="App.ico" Width="520" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Border Style="{StaticResource Card}" Margin="16">
  <StackPanel>
   <DockPanel>
    <Border x:Name="Badge" DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0"
            Background="{StaticResource SoftBlue}" CornerRadius="12" VerticalAlignment="Top">
     <TextBlock x:Name="BadgeText" Text="i" Foreground="{StaticResource Accent}" FontSize="20" FontWeight="SemiBold"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <StackPanel>
     <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
     <TextBlock x:Name="Message" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
    </StackPanel>
   </DockPanel>
   <TextBox x:Name="Report" Visibility="Collapsed" Margin="0,14,0,0" Height="180" IsReadOnly="True"
            TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Подробности импорта"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
    <Button x:Name="ConfirmButton" Visibility="Collapsed" Style="{StaticResource DangerButton}" Margin="0,0,8,0"
            Content="Да, удалить" Click="ConfirmClick"/>
    <Button x:Name="CloseButton" Content="Закрыть" IsDefault="True" IsCancel="True" Click="CloseClick"/>
   </StackPanel>
  </StackPanel>
 </Border>
</Window>
