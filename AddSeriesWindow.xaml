<Window x:Class="TVShowsTracker.AddSeriesWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource AppWindow}" Icon="App.ico" Title="Добавить сериал"
 Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 ShowInTaskbar="False" PreviewKeyDown="OnPreviewKeyDown">
 <Border Style="{StaticResource Card}" Margin="16">
  <StackPanel>
   <TextBlock Text="КАТАЛОГ TVMAZE" Style="{StaticResource Eyebrow}"/>
   <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
              Style="{StaticResource SectionTitle}" Margin="0,3,0,13"/>
   <Border x:Name="ImportLinePanel" Visibility="Collapsed" Background="{StaticResource SoftBlue}" CornerRadius="10"
           Padding="10,8" Margin="0,0,0,10">
    <StackPanel>
     <TextBlock Text="СТРОКА ИМПОРТА" Style="{StaticResource Eyebrow}" Margin="0,0,0,3"/>
     <TextBlock x:Name="ImportLine" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="76"
                ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </StackPanel>
   </Border>
   <Grid>
    <TextBox x:Name="Query" AutomationProperties.Name="Название сериала" Height="46" Padding="12,0,55,0"
             VerticalContentAlignment="Center" ToolTip="Введите название сериала"/>
    <TextBlock Text="Введите название сериала" Margin="13,0,55,0" VerticalAlignment="Center" IsHitTestVisible="False"
               Foreground="{StaticResource Muted}">
     <TextBlock.Style>
      <Style TargetType="TextBlock">
       <Setter Property="Visibility" Value="Collapsed"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding Text, ElementName=Query}" Value="">
         <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
    <Button x:Name="SearchButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,5,0"
            Click="SearchClick" IsDefault="True" ToolTip="Найти сериал" AutomationProperties.Name="Найти сериал">
     <Path Style="{StaticResource Icon}" Data="{StaticResource SearchIcon}"/>
    </Button>
   </Grid>
   <ListBox x:Name="Results" Visibility="Collapsed" Margin="0,12,0,0" MaxHeight="260"
            AutomationProperties.Name="Результаты поиска" PreviewKeyDown="ResultsKeyDown">
    <ListBox.ItemContainerStyle>
     <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <EventSetter Event="MouseDoubleClick" Handler="ResultDoubleClick"/>
     </Style>
    </ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate>
     <DataTemplate>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Height="48" Background="{StaticResource PressedBlue}" CornerRadius="6">
        <Grid>
         <Path Style="{StaticResource Icon}" Data="{StaticResource FilmIcon}" Stroke="{StaticResource Accent}"/>
         <Image Source="{Binding image.medium}" Stretch="Uniform" ImageFailed="ThumbnailFailed"/>
        </Grid>
       </Border>
       <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="10,0,0,0" FontWeight="SemiBold"
                  TextWrapping="Wrap" VerticalAlignment="Center"/>
      </Grid>
     </DataTemplate>
    </ListBox.ItemTemplate>
   </ListBox>
   <TextBlock x:Name="Status" Margin="0,10,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
              AutomationProperties.LiveSetting="Polite">
    <TextBlock.Style>
     <Style TargetType="TextBlock">
      <Style.Triggers>
       <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
      </Style.Triggers>
     </Style>
    </TextBlock.Style>
   </TextBlock>
   <Button x:Name="SkipButton" Visibility="Collapsed" Margin="0,12,0,0"
           HorizontalAlignment="Right" Content="Пропустить строку" Click="SkipClick"/>
   <Button x:Name="ManualButton" Visibility="Collapsed" Margin="0,12,0,0"
           HorizontalAlignment="Right" Content="Добавить вручную…" Click="ManualClick"/>
  </StackPanel>
 </Border>
</Window>
