<Window x:Class="TVShowsTracker.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource AppWindow}" Title="Настройки" Width="420" SizeToContent="Height"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent">
 <Border Margin="10" Padding="18,14" CornerRadius="12" Background="{StaticResource Tile}"
         BorderBrush="{StaticResource Line}" BorderThickness="1">
  <Border.Effect>
   <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity=".24"/>
  </Border.Effect>
  <StackPanel>
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBlock Style="{StaticResource SectionTitle}" Margin="5,0,0,0" VerticalAlignment="Center"
               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"/>
    <ToggleButton x:Name="RefreshOnStartup" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                  Click="RefreshOnStartupClick" Cursor="Hand" MinHeight="36"
                  Foreground="{StaticResource Ink}" AutomationProperties.Name="Обновлять каталог при запуске">
     <TextBlock Text="Обновлять каталог при запуске" TextWrapping="Wrap"/>
     <ToggleButton.Template>
      <ControlTemplate TargetType="ToggleButton">
       <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
               CornerRadius="9" Padding="4,3">
        <DockPanel>
         <Border x:Name="Track" DockPanel.Dock="Left" Width="40" Height="20" VerticalAlignment="Center"
                 CornerRadius="10" Background="#8B97A3" Margin="0,0,12,0">
          <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="White" Margin="4,0"
                   VerticalAlignment="Center" HorizontalAlignment="Left"/>
         </Border>
         <ContentPresenter VerticalAlignment="Center"/>
        </DockPanel>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True">
         <Setter TargetName="Track" Property="Background" Value="{StaticResource Blue}"/>
         <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
         <Setter TargetName="Row" Property="Background" Value="{StaticResource SoftBlue}"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
         <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Focus}"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
         <Setter TargetName="Row" Property="Opacity" Value=".55"/>
        </Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate>
     </ToggleButton.Template>
    </ToggleButton>
    <Button Grid.Column="1" Margin="8,0,0,0"
            Foreground="{StaticResource Muted}" ToolTip="Закрыть" AutomationProperties.Name="Закрыть"
            IsCancel="True" Click="CloseClick">
     <Button.Style>
      <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
       <Setter Property="Background" Value="Transparent"/>
      </Style>
     </Button.Style>
     <Path Style="{StaticResource Icon}" Width="14" Height="14" Data="M 2,2 L 12,12 M 12,2 L 2,12"/>
    </Button>
   </Grid>
   <TextBlock x:Name="SettingsError" Visibility="Collapsed" Margin="4,8,4,0" TextWrapping="Wrap"
              Foreground="{StaticResource Danger}"/>
  </StackPanel>
 </Border>
</Window>
