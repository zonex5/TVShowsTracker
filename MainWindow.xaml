<Window x:Class="TVShowsTracker.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource AppWindow}" Icon="App.ico" Title="TVShowsTracker · Дневник просмотра"
 Width="1120" Height="760" MinWidth="830" MinHeight="540" WindowStartupLocation="CenterScreen"
 Loaded="OnLoaded" PreviewKeyDown="WindowPreviewKeyDown">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
 </Window.Resources>
 <Grid Margin="22,18,22,14">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,17" LastChildFill="True">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="ImportButton" Style="{StaticResource IconButton}" Margin="0,0,7,0"
            ToolTipService.ShowOnDisabled="True"
            ToolTip="Импортировать из текстового файла" AutomationProperties.Name="Импортировать из текстового файла" Click="ImportClick">
     <Path Style="{StaticResource Icon}" Data="{StaticResource ImportIcon}"/>
    </Button>
    <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Margin="0,0,7,0"
            ToolTip="Обновить каталог" AutomationProperties.Name="Обновить каталог" Click="RefreshClick">
     <Path x:Name="RefreshGlyph" Style="{StaticResource Icon}" Data="{StaticResource RefreshIcon}"/>
    </Button>
    <Button Style="{StaticResource IconButton}" Margin="0,0,10,0"
            ToolTip="Настройки" AutomationProperties.Name="Настройки" Click="OpenSettings">
     <Path Style="{StaticResource Icon}" Data="{StaticResource SettingsIcon}"/>
    </Button>
    <Button x:Name="OpenSearchButton" Style="{StaticResource PrimaryButton}" Height="38"
            AutomationProperties.Name="Добавить сериал" Click="OpenSearch">
     <StackPanel Orientation="Horizontal">
      <Path Style="{StaticResource Icon}" Data="{StaticResource PlusIcon}" Margin="0,0,8,0"/>
      <TextBlock Text="Добавить сериал"/>
     </StackPanel>
    </Button>
   </StackPanel>
   <Border DockPanel.Dock="Left" Width="48" Height="48" Margin="0,0,12,0"
           Background="{StaticResource Blue}" CornerRadius="15" VerticalAlignment="Center">
    <Path Style="{StaticResource Icon}" Width="24" Height="24" Stroke="White" Data="{StaticResource FilmIcon}"/>
   </Border>
   <StackPanel VerticalAlignment="Center">
    <TextBlock Text="TVSHOWSTRACKER" Style="{StaticResource Eyebrow}"/>
    <TextBlock Text="Дневник просмотра" FontSize="29" FontWeight="SemiBold"/>
   </StackPanel>
  </DockPanel>

  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="14">
    <DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="3,0,14,7">
      <Button x:Name="LibrarySearchButton" DockPanel.Dock="Right" Width="32" Height="30" MinHeight="0"
              Click="ToggleLibrarySearch">
       <Button.Style>
        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
         <Setter Property="ToolTip" Value="Показать поиск в библиотеке"/>
         <Setter Property="AutomationProperties.Name" Value="Показать поиск в библиотеке"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding Visibility, ElementName=LibrarySearchPanel}" Value="Visible">
           <Setter Property="ToolTip" Value="Скрыть поиск в библиотеке"/>
           <Setter Property="AutomationProperties.Name" Value="Скрыть поиск в библиотеке"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </Button.Style>
       <Path Style="{StaticResource Icon}" Data="{StaticResource SearchIcon}"/>
      </Button>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <TextBlock Text="Моя библиотека" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="{Binding Items.Count, ElementName=Shows}" Margin="8,0,0,0"
                  VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}"/>
      </StackPanel>
     </DockPanel>
     <Grid x:Name="LibrarySearchPanel" DockPanel.Dock="Top" Margin="0,0,0,10" Visibility="Collapsed">
      <TextBox x:Name="LibraryQuery" Height="38" Padding="34,0,40,0" VerticalContentAlignment="Center"
               AutomationProperties.Name="Поиск в библиотеке" TextChanged="LibraryQueryChanged"/>
      <Path Style="{StaticResource Icon}" Data="{StaticResource SearchIcon}" Stroke="{StaticResource Muted}"
            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
      <TextBlock Text="Поиск в библиотеке" Margin="34,0,40,0" VerticalAlignment="Center"
                 Foreground="{StaticResource Muted}" IsHitTestVisible="False">
       <TextBlock.Style>
        <Style TargetType="TextBlock">
         <Setter Property="Visibility" Value="Collapsed"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding Text, ElementName=LibraryQuery}" Value="">
           <Setter Property="Visibility" Value="Visible"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </TextBlock.Style>
      </TextBlock>
      <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"
              Width="32" Height="30" MinHeight="0" ToolTip="Очистить поиск"
              AutomationProperties.Name="Очистить поиск" Click="ClearLibraryQuery">
       <Button.Style>
        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
         <Setter Property="Background" Value="Transparent"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding Text, ElementName=LibraryQuery}" Value="">
           <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </Button.Style>
       <Path Style="{StaticResource Icon}" Width="12" Height="12" Data="M 3,3 L 13,13 M 13,3 L 3,13"/>
      </Button>
     </Grid>
     <TabControl x:Name="LibraryTabs" DockPanel.Dock="Top" Margin="0,0,0,12" FontSize="11"
                 AutomationProperties.Name="Фильтр библиотеки" SelectionChanged="LibraryTabChanged">
      <TabControl.Template>
       <ControlTemplate TargetType="TabControl">
        <Border Background="{StaticResource Tile}" CornerRadius="11" Padding="3">
         <StackPanel IsItemsHost="True" Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle"/>
        </Border>
       </ControlTemplate>
      </TabControl.Template>
      <TabControl.ItemContainerStyle>
       <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
         <Setter.Value>
          <ControlTemplate TargetType="TabItem">
           <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                   CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </Border>
           <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
             <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource SoftBlue}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
             <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource PressedBlue}"/>
             <Setter Property="Foreground" Value="{StaticResource Accent}"/>
             <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
             <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource Focus}"/>
            </Trigger>
           </ControlTemplate.Triggers>
          </ControlTemplate>
         </Setter.Value>
        </Setter>
       </Style>
      </TabControl.ItemContainerStyle>
      <TabItem Header="Все"/>
      <TabItem Header="Непросмотренные" IsSelected="True"/>
      <TabItem Header="Завершённые"/>
      <TabItem Header="На паузе"/>
     </TabControl>
     <Grid>
      <ListBox x:Name="Shows" SelectionChanged="ShowChanged" AutomationProperties.Name="Моя библиотека">
       <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
         <Setter Property="ContextMenu">
          <Setter.Value><ContextMenu/></Setter.Value>
         </Setter>
         <EventSetter Event="ContextMenuOpening" Handler="ShowMenuOpening"/>
        </Style>
       </ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate>
        <DataTemplate>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Height="48" Background="{StaticResource PressedBlue}" CornerRadius="6">
           <Grid>
            <Path Style="{StaticResource Icon}" Data="{StaticResource FilmIcon}" Stroke="{StaticResource Accent}"/>
            <Image Source="{Binding Show.image.medium}" Stretch="Uniform" ImageFailed="ThumbnailFailed"/>
           </Grid>
          </Border>
          <DockPanel Grid.Column="1" Margin="10,0,0,0">
           <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Top">
            <TextBlock Text="{Binding NextUnwatchedEpisodeLabel}" FontSize="10" Foreground="{StaticResource Muted}"
                       HorizontalAlignment="Right" ToolTip="Следующая непросмотренная серия"
                       Visibility="{Binding HasUnwatchedEpisodes, Converter={StaticResource BooleanToVisibility}}"/>
           <Border Margin="0,2,0,0" Padding="6,2" HorizontalAlignment="Right"
                   Background="{StaticResource Warm}" CornerRadius="8"
                   Visibility="{Binding IsPaused, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Text="На паузе" Foreground="{StaticResource WarmInk}" FontSize="11" FontWeight="SemiBold"/>
           </Border>
           <Ellipse Width="8" Height="8" Margin="0,5,2,0" HorizontalAlignment="Right"
                    Fill="{StaticResource Focus}" ToolTip="Есть непросмотренные серии"
                    AutomationProperties.Name="Есть непросмотренные серии"
                    Visibility="{Binding ShowUnwatchedIndicator, Converter={StaticResource BooleanToVisibility}}"/>
           </StackPanel>
           <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Show.Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Show.RussianTitle}" Foreground="{StaticResource Muted}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{Binding Show.HasRussianTitle, Converter={StaticResource BooleanToVisibility}}"/>
           </StackPanel>
          </DockPanel>
         </Grid>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="LibraryEmptyMessage" Text="В этом разделе пока нет сериалов"
                 Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                 HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
       <TextBlock.Style>
        <Style TargetType="TextBlock">
         <Setter Property="Visibility" Value="Collapsed"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding HasItems, ElementName=Shows}" Value="False">
           <Setter Property="Visibility" Value="Visible"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </TextBlock.Style>
      </TextBlock>
     </Grid>
    </DockPanel>
   </Border>

   <Border x:Name="Empty" Grid.Column="2" Style="{StaticResource Card}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
     <Border Width="84" Height="84" Background="{StaticResource SoftBlue}" CornerRadius="24"
             HorizontalAlignment="Center" Margin="0,0,0,16">
      <Path Style="{StaticResource Icon}" Width="40" Height="40" Stroke="{StaticResource Focus}" Data="{StaticResource FilmIcon}"/>
     </Border>
     <TextBlock Text="Сериал не выбран" Style="{StaticResource SectionTitle}" TextAlignment="Center"/>
     <TextBlock Text="Выберите сериал в библиотеке или добавьте новый через поиск." Margin="0,6,0,0"
                TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}"/>
    </StackPanel>
   </Border>

   <Grid x:Name="Details" Grid.Column="2" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Height="114" Background="{StaticResource SoftBlue}" CornerRadius="12" VerticalAlignment="Top">
       <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
         <Path Style="{StaticResource Icon}" Width="28" Height="28" Stroke="{StaticResource Focus}" Data="{StaticResource FilmIcon}"/>
         <TextBlock Text="Постер" Margin="0,4,0,0" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
        </StackPanel>
        <Image x:Name="Cover" Stretch="Uniform" ImageFailed="PosterFailed"/>
       </Grid>
      </Border>
      <StackPanel Grid.Column="1" Margin="16,0,0,0">
       <DockPanel>
        <TextBlock x:Name="SourceLink" DockPanel.Dock="Right" Margin="10,0,0,0" FontSize="12">
         <Hyperlink Click="OpenSource">Карточка на TVmaze</Hyperlink>
        </TextBlock>
        <TextBlock Text="ПРОГРЕСС ПРОСМОТРА" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
       </DockPanel>
       <DockPanel>
        <Button x:Name="RefreshSeriesButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                Width="28" Height="28" MinHeight="0" Margin="8,2,0,0" VerticalAlignment="Top" Click="RefreshSeriesClick"
                ToolTip="Обновить сериал" AutomationProperties.Name="Обновить сериал">
         <Path Style="{StaticResource Icon}" Data="{StaticResource RefreshSeriesIcon}"/>
        </Button>
        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="28" Height="28" MinHeight="0"
                Margin="0,2,8,0" VerticalAlignment="Top" Click="CopySelectedShowTitle"
                ToolTip="Скопировать название сериала" AutomationProperties.Name="Скопировать название сериала">
         <Path Style="{StaticResource Icon}" Data="M 6,6 H 17 V 18 H 6 Z M 3,14 H 2 V 2 H 13 V 3"/>
        </Button>
       <TextBlock x:Name="ShowHeading" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="58"
                  TextTrimming="CharacterEllipsis">
        <Run x:Name="ShowTitle"/><Run x:Name="ShowRussianTitle" FontSize="15" FontWeight="Normal"
                                      Foreground="{StaticResource Muted}"/>
       </TextBlock>
       </DockPanel>
       <TextBlock x:Name="ProgressText" Foreground="{StaticResource Muted}" Margin="0,4,0,7"/>
       <ProgressBar x:Name="Progress" Height="7" AutomationProperties.Name="Прогресс просмотра"/>
       <TextBlock x:Name="CurrentText" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                  ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      </StackPanel>
     </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,13">
     <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="Серии" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
      <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4" TextElement.FontSize="12">
       <ComboBox x:Name="Seasons" MinWidth="106" Padding="9,5,28,5" DisplayMemberPath="Label" SelectionChanged="SeasonChanged"
                 AutomationProperties.Name="Сезон" Margin="0,0,7,6"/>
       <Button x:Name="MarkSeasonButton" Padding="9,5" Content="Отметить сезон" Click="MarkSeason" Margin="0,0,7,6"/>
       <Button x:Name="PauseButton" Padding="9,5" Content="Поставить на паузу" Click="TogglePause" Margin="0,0,0,6"/>
      </WrapPanel>
      <ListBox x:Name="Episodes" AutomationProperties.Name="Список серий">
       <ListBox.ItemTemplate>
        <DataTemplate>
         <DockPanel>
          <Button DockPanel.Dock="Right" Margin="8,0,0,0" Width="30" Height="28" MinHeight="0" Padding="0"
                  ToolTip="{Binding CurrentToolTip}" Click="SetCurrent" AutomationProperties.Name="{Binding CurrentLabel}">
           <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
             <Setter Property="Visibility" Value="Hidden"/>
             <Style.Triggers>
              <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
               <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
               <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsCurrent}" Value="True">
               <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding CanToggleCurrent}" Value="False">
               <Setter Property="Visibility" Value="Hidden"/>
              </DataTrigger>
             </Style.Triggers>
            </Style>
           </Button.Style>
           <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
            <Path.Style>
             <Style TargetType="Path">
              <Setter Property="Data" Value="M 0,0 L 9,5.5 L 0,11 Z"/>
              <Style.Triggers>
               <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Data" Value="M 0,0 H 9 V 9 H 0 Z"/>
               </DataTrigger>
              </Style.Triggers>
             </Style>
            </Path.Style>
           </Path>
          </Button>
          <CheckBox IsChecked="{Binding Watched, Mode=OneWay}" Click="ToggleWatched"
                    IsEnabled="{Binding CanToggleWatched}"
                    AutomationProperties.Name="{Binding Label}">
           <TextBlock TextWrapping="Wrap">
            <TextBlock.Style>
             <Style TargetType="TextBlock">
              <Style.Triggers>
               <DataTrigger Binding="{Binding IsUnreleased}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
               </DataTrigger>
              </Style.Triggers>
             </Style>
            </TextBlock.Style>
            <Run Text="{Binding Label}"/>
            <InlineUIContainer BaselineAlignment="Center">
             <StackPanel Orientation="Horizontal" Margin="6,0,0,0"
                         Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibility}}">
              <Path Data="M 4,0 L 0,3 L 4,6 Z" Width="4" Height="6" Margin="0,0,4,0"
                    Fill="{StaticResource CurrentEpisodeHint}" VerticalAlignment="Center">
               <Path.RenderTransform><TranslateTransform Y="2"/></Path.RenderTransform>
              </Path>
              <TextBlock Text="смотрю" FontSize="12" Foreground="{StaticResource CurrentEpisodeHint}" VerticalAlignment="Center"/>
             </StackPanel>
            </InlineUIContainer>
           </TextBlock>
          </CheckBox>
         </DockPanel>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
    </Border>
   </Grid>
  </Grid>
  <Border x:Name="RefreshStatusBar" Grid.Row="2" Style="{StaticResource Card}" CornerRadius="11"
          Padding="12,6" Margin="0,10,0,0" Visibility="Collapsed">
   <DockPanel>
    <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{StaticResource Focus}" Margin="0,0,7,0"/>
    <TextBlock x:Name="RefreshStatus" Foreground="{StaticResource Muted}" FontSize="12"
               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
