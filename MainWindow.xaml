<Window x:Class="TVShowsTracker.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Icon="App.ico" Title="TVShowsTracker · Дневник просмотра" Width="1120" Height="760"
 MinWidth="830" MinHeight="540" Background="#F3F5FA" Foreground="#20283A"
 FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen"
 Loaded="OnLoaded">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
   <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
  </ResourceDictionary>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions>
   <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#FFFFFF" CornerRadius="12" Padding="12">
    <DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="4,0,0,10">
      <Button x:Name="RefreshButton" DockPanel.Dock="Right" Width="26" Height="26" Padding="0"
              ToolTip="Обновить каталог" AutomationProperties.Name="Обновить каталог" Click="RefreshClick">
       <Path Data="M 11,5 A 5,5 0 1 0 11,8 M 11,1 L 11,5 L 7,5" Stroke="#20283A" StrokeThickness="1.4"/>
      </Button>
      <Button x:Name="ImportButton" DockPanel.Dock="Right" Width="26" Height="26" Padding="0" Margin="0,0,4,0"
              ToolTip="Импортировать из текстового файла" AutomationProperties.Name="Импортировать из текстового файла" Click="ImportClick">
       <Path Data="M 6,1 V 8 M 3,5 L 6,8 L 9,5 M 1,8 V 11 H 11 V 8" Stroke="#20283A" StrokeThickness="1.4"/>
      </Button>
      <Button x:Name="OpenSearchButton" DockPanel.Dock="Right" Width="26" Height="26" Padding="0" Margin="0,0,4,0"
              ToolTip="Добавить сериал" AutomationProperties.Name="Добавить сериал" Click="OpenSearch">
       <Path Data="M 1,6 H 11 M 6,1 V 11" Stroke="#20283A" StrokeThickness="1.4"/>
      </Button>
      <TextBlock Text="МОЯ БИБЛИОТЕКА" FontWeight="SemiBold" VerticalAlignment="Center"
                 Foreground="{StaticResource Muted}"/>
     </DockPanel>
     <TabControl x:Name="LibraryTabs" DockPanel.Dock="Bottom" TabStripPlacement="Bottom"
                 Margin="0,8,0,0" FontSize="11" SelectedIndex="0"
                 AutomationProperties.Name="Фильтр библиотеки" SelectionChanged="LibraryTabChanged">
      <TabControl.Template>
       <ControlTemplate TargetType="TabControl">
        <Border BorderBrush="#C9D2E2" BorderThickness="0,0,0,1">
         <StackPanel IsItemsHost="True" Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle"/>
        </Border>
       </ControlTemplate>
      </TabControl.Template>
      <TabControl.ItemContainerStyle>
       <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="#526078"/>
        <Setter Property="Padding" Value="6,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
         <Setter.Value>
          <ControlTemplate TargetType="TabItem">
           <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2"
                   CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </Border>
           <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
             <Setter TargetName="TabSurface" Property="Background" Value="#DFE5F3"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
             <Setter TargetName="TabSurface" Property="Background" Value="#DDD3FC"/>
             <Setter TargetName="TabSurface" Property="BorderBrush" Value="#6748CE"/>
             <Setter Property="Foreground" Value="#563BB1"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
             <Setter TargetName="TabSurface" Property="BorderBrush" Value="#563BB1"/>
             <Setter TargetName="TabSurface" Property="BorderThickness" Value="1,1,1,2"/>
            </Trigger>
           </ControlTemplate.Triggers>
          </ControlTemplate>
         </Setter.Value>
        </Setter>
       </Style>
      </TabControl.ItemContainerStyle>
      <TabItem Header="Все"/>
      <TabItem Header="Непросмотренные"/>
      <TabItem Header="Завершённые"/>
      <TabItem Header="На паузе"/>
     </TabControl>
     <ListBox x:Name="Shows" SelectionChanged="ShowChanged"
              AutomationProperties.Name="Моя библиотека">
      <ListBox.ItemContainerStyle>
       <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="ContextMenu">
         <Setter.Value><ContextMenu/></Setter.Value>
        </Setter>
        <EventSetter Event="ContextMenuOpening" Handler="ShowMenuOpening"/>
       </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
       <DataTemplate>
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="34"/>
          <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
         <Border Height="48" Background="#EDF0F7" CornerRadius="4">
          <Grid>
           <TextBlock Text="▧" Foreground="{StaticResource Muted}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
           <Image Source="{Binding Show.image.medium}" Stretch="Uniform"
                  ImageFailed="ThumbnailFailed"/>
          </Grid>
         </Border>
         <DockPanel Grid.Column="1" Margin="9,0,0,0">
          <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Margin="5,0,0,0"
                   VerticalAlignment="Center" Fill="#6748CE" ToolTip="Есть непросмотренные серии"
                   AutomationProperties.Name="Есть непросмотренные серии"
                   Visibility="{Binding ShowUnwatchedIndicator, Converter={StaticResource BooleanToVisibility}}"/>
          <Border DockPanel.Dock="Right" Width="14" Height="14" Margin="5,0,0,0"
                  VerticalAlignment="Center" Background="#FFF0D5" CornerRadius="3"
                  ToolTip="На паузе" AutomationProperties.Name="На паузе"
                  Visibility="{Binding IsPaused, Converter={StaticResource BooleanToVisibility}}">
           <Path Data="M 0,0 V 7 M 4,0 V 7" Stroke="#80510D" StrokeThickness="2"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{Binding Show.Label}" TextWrapping="Wrap" VerticalAlignment="Center"/>
         </DockPanel>
        </Grid>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <TextBlock x:Name="Empty" Grid.Column="2" Text="Найдите сериал и добавьте его в библиотеку"
              Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   <Border x:Name="Details" Grid.Column="2" Background="#FFFFFF" CornerRadius="12" Padding="16" Visibility="Collapsed">
    <DockPanel>
     <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Height="126" Background="#EDF0F7" CornerRadius="8">
       <Grid>
        <TextBlock Text="Постер" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Image x:Name="Cover" Stretch="Uniform" ImageFailed="PosterFailed"/>
       </Grid>
      </Border>
      <StackPanel Grid.Column="1" Margin="14,0,0,0">
       <TextBlock x:Name="ShowTitle" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock x:Name="ProgressText" Foreground="{StaticResource Muted}" Margin="0,5,0,4"/>
       <ProgressBar x:Name="Progress" Height="5" Foreground="#6748CE" Background="#E6E1F5"/>
       <TextBlock x:Name="CurrentText" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
       <TextBlock Margin="0,5,0,0"><Hyperlink Foreground="#563BB1" Click="OpenSource">Карточка на TVmaze</Hyperlink></TextBlock>
      </StackPanel>
     </Grid>
     <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <ComboBox x:Name="Seasons" MinWidth="110" DisplayMemberPath="Label" SelectionChanged="SeasonChanged"
                AutomationProperties.Name="Сезон" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
      <Button x:Name="MarkSeasonButton" Content="Отметить сезон" Click="MarkSeason" Margin="0,0,8,0"/>
      <Button x:Name="PauseButton" Content="Поставить на паузу" Click="TogglePause"/>
     </WrapPanel>
     <ListBox x:Name="Episodes" AutomationProperties.Name="Список серий">
      <ListBox.ItemTemplate>
       <DataTemplate>
        <DockPanel>
         <Button DockPanel.Dock="Right" Margin="8,0,0,0" Width="28" Height="26" Padding="0"
                 ToolTip="Смотрю" Click="SetCurrent" AutomationProperties.Name="{Binding CurrentLabel}">
          <Button.Style>
           <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Visibility" Value="Hidden"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </Button.Style>
          <Path Width="9" Height="11" Stretch="Fill" Data="M 0,0 L 9,5.5 L 0,11 Z"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
         </Button>
         <CheckBox Content="{Binding Label}" IsChecked="{Binding Watched, Mode=OneWay}"
                   Click="ToggleWatched" Foreground="#20283A" VerticalContentAlignment="Center"/>
        </DockPanel>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
  </Grid>
  <DockPanel Grid.Row="1" Margin="0,12,0,0">
   <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0"><Hyperlink Foreground="#563BB1" Click="OpenAttribution">Данные TVmaze · CC BY-SA</Hyperlink></TextBlock>
   <TextBlock x:Name="Status" Foreground="{StaticResource Muted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  </DockPanel>
 </Grid>
</Window>
