<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Muted" Color="#526078"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#20283A"/>
   <Setter Property="Background" Value="#EDF0F7"/>
   <Setter Property="Padding" Value="14,8"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8"
              Padding="{TemplateBinding Padding}" BorderBrush="#8C98AF" BorderThickness="1">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DFE5F3"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".45"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#563BB1"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ListBox">
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="Foreground" Value="#20283A"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Padding" Value="10,8"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
 </ResourceDictionary>